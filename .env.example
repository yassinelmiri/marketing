NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Serveur uniquement. Ne jamais utiliser NEXT_PUBLIC_ pour cette clé.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Clé AES-256-GCM pour chiffrer les mots de passe SMTP (64 caractères hexadécimaux).
# Générer avec: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=YOUR_64_CHARACTER_HEX_KEY

# Secret utilisé par Vercel Cron pour exécuter la file des campagnes e-mail.
# Définir une valeur aléatoire longue dans les variables d'environnement Vercel.
CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET
